 #pragma comment(lib, "Comctl32.lib")
 #endif
 
+#include <dxgi1_6.h>
+#include <wrl/client.h>
+#include <string>
+#include <vector>
+#pragma comment(lib, "dxgi.lib")
+
+// ManchesterRTX: HDR state of the primary display - whether Windows HDR is on, the luminance range the display (or its
+// Windows HDR Calibration profile) reports, and Windows' SDR content brightness
+bool g_HdrOutput = false;
+DisplayHdrInfo g_DisplayHdr;
+
+DisplayHdrInfo QueryDisplayHdr()
+{
+    DisplayHdrInfo info;
+    using Microsoft::WRL::ComPtr;
+    ComPtr<IDXGIFactory1> factory;
+    if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory))))
+        return info;
+    const HMONITOR primary = MonitorFromPoint(POINT{ 0, 0 }, MONITOR_DEFAULTTOPRIMARY);
+    std::wstring deviceName;
+    ComPtr<IDXGIAdapter1> adapter;
+    for (UINT a = 0; factory->EnumAdapters1(a, &adapter) != DXGI_ERROR_NOT_FOUND; a++)
+    {
+        ComPtr<IDXGIOutput> output;
+        for (UINT o = 0; adapter->EnumOutputs(o, &output) != DXGI_ERROR_NOT_FOUND; o++)
+        {
+            ComPtr<IDXGIOutput6> output6;
+            DXGI_OUTPUT_DESC1 desc = {};
+            if (FAILED(output.As(&output6)) || FAILED(output6->GetDesc1(&desc)) || desc.Monitor != primary)
+                continue;
+            info.Active = desc.ColorSpace == DXGI_COLOR_SPACE_RGB_FULL_G2084_NONE_P2020;
+            info.MaxLuminance = desc.MaxLuminance;
+            info.MinLuminance = desc.MinLuminance;
+            info.MaxFullFrameLuminance = desc.MaxFullFrameLuminance;
+            deviceName = desc.DeviceName;
+        }
+    }
+    // SDR white level of the same display (DISPLAYCONFIG_SDR_WHITE_LEVEL: 1000 = 80 nits)
+    UINT32 pathCount = 0, modeCount = 0;
+    if (!deviceName.empty() && GetDisplayConfigBufferSizes(QDC_ONLY_ACTIVE_PATHS, &pathCount, &modeCount) == ERROR_SUCCESS)
+    {
+        std::vector<DISPLAYCONFIG_PATH_INFO> paths(pathCount);
+        std::vector<DISPLAYCONFIG_MODE_INFO> modes(modeCount);
+        if (QueryDisplayConfig(QDC_ONLY_ACTIVE_PATHS, &pathCount, paths.data(), &modeCount, modes.data(), nullptr) == ERROR_SUCCESS)
+            for (UINT32 i = 0; i < pathCount; i++)
+            {
+                DISPLAYCONFIG_SOURCE_DEVICE_NAME source = {};
+                source.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SOURCE_NAME;
+                source.header.size = sizeof(source);
+                source.header.adapterId = paths[i].sourceInfo.adapterId;
+                source.header.id = paths[i].sourceInfo.id;
+                if (DisplayConfigGetDeviceInfo(&source.header) != ERROR_SUCCESS || deviceName != source.viewGdiDeviceName)
+                    continue;
+                DISPLAYCONFIG_SDR_WHITE_LEVEL white = {};
+                white.header.type = DISPLAYCONFIG_DEVICE_INFO_GET_SDR_WHITE_LEVEL;
+                white.header.size = sizeof(white);
+                white.header.adapterId = paths[i].targetInfo.adapterId;
+                white.header.id = paths[i].targetInfo.id;
+                if (DisplayConfigGetDeviceInfo(&white.header) == ERROR_SUCCESS && white.SDRWhiteLevel > 0)
+                    info.SdrWhiteNits = white.SDRWhiteLevel / 1000.0f * 80.0f;
+            }
+    }
+    return info;
+}
