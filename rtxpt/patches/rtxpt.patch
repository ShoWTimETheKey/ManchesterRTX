+// ManchesterRTX night sky (sky frame, z up): the city's light pollution - sodium and LED light scattered by the haze,
+// warm and bright at the horizon, fading upwards into a deep blue-black - and a star field from a hashed grid on the
+// sphere (one candidate per cell, few of them lit, the brightest rare), drowned by the glow near the horizon
+float3 NightSky(float3 dir, float glow, float stars)
+{
+    const float h = dir.z;
+    float3 c = 0;
+    if (glow > 0)
+    {
+        const float up = saturate(h);
+        c += glow * (float3(1.0, 0.60, 0.36) * exp(-up * 9.0) + float3(0.05, 0.07, 0.15) * exp(-up * 1.2));
+        if (h < 0) c += glow * float3(1.0, 0.60, 0.36) * 0.5;
+    }
+    if (stars > 0 && h > 0.03)
+    {
+        const float el = asin(saturate(h)), az = atan2(dir.y, dir.x);
+        const float cell = 0.0045;      // radians
+        const float2 g = float2(az * cos(el), el) / cell, gi = floor(g);
+        const uint hsh = Hash32Combine(Hash32(asuint(gi.x) + 7919u), asuint(gi.y));
+        if (Hash32ToFloat(hsh) > 0.982)
+        {
+            const float2 jitter = float2(Hash32ToFloat(Hash32(hsh + 1u)), Hash32ToFloat(Hash32(hsh + 2u))) * 0.6 + 0.2;
+            const float dist = length(g - gi - jitter) * cell, size = 0.0014;
+            const float mag = 0.15 + 3.0 * pow(Hash32ToFloat(Hash32(hsh + 3u)), 8.0);
+            const float3 tint = lerp(float3(0.78, 0.86, 1.0), float3(1.0, 0.88, 0.72), Hash32ToFloat(Hash32(hsh + 4u)));
+            c += stars * mag * tint * exp(-dist * dist / (size * size)) * smoothstep(0.03, 0.35, h);
+        }
+    }
+    return c;
+}
