+void SampleUI::Render(nvrhi::IFramebuffer* framebuffer)
+{
+    ManchesterApp* manchester = m_app.GetManchester();
+    if (manchester == nullptr || !imgui_nvrhi)
+    {
+        ImGui_Renderer::Render(framebuffer);
+        return;
+    }
+
+    // ManchesterRTX: the GUI is drawn into its own premultiplied layer - liquid glass first, then the ImGui content -
+    // and composited over the frame; DLSS-G gets the layer and the hudless frame for UI recomposition
+    if (!m_uiLayer)
+        m_uiLayer = std::make_unique<ManchesterUILayer>(GetDevice(), m_app.GetShaderFactory(), m_app.GetCommonPasses());
+
+    nvrhi::ITexture* backBuffer = framebuffer->getDesc().colorAttachments[0].texture;
+    nvrhi::ITexture* hudless = m_app.GetHudlessColor();
+    if (hudless && (hudless->getDesc().width != backBuffer->getDesc().width || hudless->getDesc().height != backBuffer->getDesc().height))
+        hudless = nullptr;      // mid-resize
+
+    // the UI is built first, so the glass under it is this frame's layout (no lag behind sliding panels)
+    buildUI();
+    ImGui::Render();
+
+    UILayerOutput output;
+    output.Hdr10 = g_HdrOutput;
+    output.UIWhiteNits = manchester->GetUIWhiteNits();
+    m_commandList->open();
+    nvrhi::IFramebuffer* uiFramebuffer = m_uiLayer->Begin(m_commandList, backBuffer, hudless, manchester->GetGlassFrame(), output);
+    m_commandList->close();
+    GetDevice()->executeCommandList(m_commandList);
+
+    imgui_nvrhi->render(uiFramebuffer);
+    m_imguiFrameOpened = false;
+
+    m_commandList->open();
+    m_uiLayer->Finish(m_commandList);
+    m_uiLayer->Composite(m_commandList, framebuffer, backBuffer);
+#if DONUT_WITH_STREAMLINE
+    if (hudless != nullptr && m_ui.ActualDLSSFGMode() == SI::DLSSGMode::eOn)
+    {
+        m_commandList->setTextureState(hudless, nvrhi::AllSubresources, nvrhi::ResourceStates::ShaderResource);
+        m_commandList->setTextureState(m_uiLayer->GetTexture(), nvrhi::AllSubresources, nvrhi::ResourceStates::ShaderResource);
+        m_commandList->commitBarriers();
+        GetDeviceManager()->GetStreamline().TagResourcesHudlessAndUI(m_commandList, m_app.GetCurrentView().get(), hudless, m_uiLayer->GetTexture());
+    }
+#endif
+    m_commandList->close();
+    GetDevice()->executeCommandList(m_commandList);
+}
