+void StreamlineIntegration::TagResourcesHudlessAndUI(
+    nvrhi::ICommandList* commandList,
+    const donut::engine::IView* view,
+    nvrhi::ITexture* hudless,
+    nvrhi::ITexture* uiColorAndAlpha)
+{
+    if (!m_slInitialized)
+    {
+        log::warning("Streamline not initialised.");
+        return;
+    }
+
+    sl::Extent fullExtent{ 0, 0, hudless->getDesc().width, hudless->getDesc().height };
+    void* cmdbuffer = GetNativeCommandList(commandList);
+    sl::Resource hudlessResource{}, uiResource{};
+    GetSLResource(commandList, hudlessResource, hudless, view);
+    GetSLResource(commandList, uiResource, uiColorAndAlpha, view);
+
+    sl::ResourceTag hudlessTag = sl::ResourceTag{ &hudlessResource, sl::kBufferTypeHUDLessColor, sl::ResourceLifecycle::eValidUntilPresent, &fullExtent };
+    sl::ResourceTag uiTag = sl::ResourceTag{ &uiResource, sl::kBufferTypeUIColorAndAlpha, sl::ResourceLifecycle::eValidUntilPresent, &fullExtent };
+    sl::ResourceTag inputs[] = { hudlessTag, uiTag };
+    successCheck(slSetTag(m_viewport, inputs, _countof(inputs), cmdbuffer), "slSetTag_HudlessAndUI");
+}
